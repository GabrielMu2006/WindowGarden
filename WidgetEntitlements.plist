<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- 沙盒化组件经 App Group 容器读取引擎写入的共享状态与插画。
         不能用 temporary-exception 读 ~/Library/Application Support：
         Foundation 在沙盒内会把该目录重定向到组件自己的容器，
         且 temporary-exception 对 ad-hoc/开发签名不生效（实测 EPERM）。 -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.windowgarden.app</string>
    </array>
</dict>
</plist>
